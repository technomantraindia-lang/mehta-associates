# ==============================================================================
# Mehta Associates - Production Web Server Configuration (.htaccess)
# Domain: https://mehtaassociates.co.in/
# ==============================================================================

# 1. CHARACTER ENCODING
AddDefaultCharset UTF-8
AddCharset UTF-8 .html .css .js .json .xml

# 2. FORCE HTTPS & CANONICAL URLS
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect non-HTTPS to HTTPS
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Redirect index.html to root
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html\ HTTP/
  RewriteRule ^index\.html$ https://%{HTTP_HOST}/ [R=301,L]
</IfModule>

# 3. CUSTOM ERROR PAGES
ErrorDocument 404 /404.html

# 4. GZIP / BROTLI COMPRESSION (mod_deflate)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/ttf
  AddOutputFilterByType DEFLATE font/otf
  AddOutputFilterByType DEFLATE font/woff
  AddOutputFilterByType DEFLATE font/woff2
</IfModule>

# 5. BROWSER CACHING (mod_expires)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML documents (1 hour so updates show quickly)
  ExpiresByType text/html "access plus 1 hour"

  # Data files
  ExpiresByType application/json "access plus 1 day"
  ExpiresByType application/xml "access plus 1 day"
  ExpiresByType text/xml "access plus 1 day"

  # CSS & JavaScript
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"

  # Media: Images, Icons, Favicons (1 year)
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Web Fonts (1 year)
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"

  # PDFs
  ExpiresByType application/pdf "access plus 1 month"
</IfModule>

# 6. CACHE-CONTROL HEADERS (mod_headers)
<IfModule mod_headers.c>
  # 1 Year Cache for Static Assets
  <FilesMatch "\.(ico|jpe?g|png|webp|svg|woff|woff2|ttf|otf|pdf)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>

  # 1 Month Cache for CSS and JS
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "max-age=2592000, public"
  </FilesMatch>

  # HTML Documents
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "max-age=3600, must-revalidate, public"
  </FilesMatch>

  # Security Headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# 7. SECURITY & ACCESS CONTROL
# Block access to hidden files and internal server tools
<FilesMatch "(^\.|\.git|\.env|serve\.js|package\.json|package-lock\.json|\.md$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Prevent Directory Browsing
Options -Indexes
